/dts-v1/;
/addon/;

/import/ abc: "foo,bar";
/import/ de1: "foo,bar";
/import/ de2: "foo,bar";

/ {

	node-a {
		prop_a = <0x1c8>;
		prop_b = <0x7b>;

		/export/ a: &{/node-b};
		/export/ ba: &{/node-b};
		/export/ bb: &{/node-b};
	};

	node-b {
		phandle = <0x01>;
	};
};

&abc {
	prop-a = "a";
	prop-b = "b";

	node-a {
		prop = <0x01>;
	};

	node-b {
		prop = <0x02>;
	};

	node-c {
		prop = <0x03>;
	};
};

&de1 {
	prop-a = "a";
	prop-b = "b";

	node-a {
		prop = <0x01>;
	};

	node-b {
		prop = <0x02>;
	};

	node-c {
		prop = <0x03>;
	};
};

&de2 {
	prop-a = "a";
	prop-b = "b";
};
