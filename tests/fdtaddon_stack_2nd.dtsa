/dts-v1/;
/addon/;

/import/ stack: "abc,bbb";
/import/ other: "";
/import/ base_other: "";

&stack {
	addon2_node: addon2-node {
		prop = <0>;
		ref-other = <&other 10>;
	};
};

&other {
	addon2-node-other {
		prop = <&base_other>;

		addon2-subnode {
			prop = <2>;
		};
	};
};

&base_other {
	addon2-node-base-other {
		prop = <1>;
		ref = <&addon2_node>;
	};
};
