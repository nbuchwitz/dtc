/dts-v1/;
/addon/;

/import/ de1: "foo,bar";
/import/ abc: "foo,bar";
/import/ de2: "foo,bar";

/ {
	node_b: node-b {
	};

	node-a {
		prop_b = <123>;
		prop_a = <456>;

		/export/ ba: &node_b;
		/export/ bb: &node_b;
		/export/ a: &node_b;
	};
};

&de2 {
	prop-b = "b";
	prop-a = "a";
};

&abc {
	prop-b = "b";
	prop-a = "a";
	node-b {
		prop = <2>;
	};
	node-a {
		prop = <1>;
	};
	node-c {
		prop = <3>;
	};
};

&de1 {
	prop-b = "b";
	prop-a = "a";
	node-b {
		prop = <2>;
	};
	node-a {
		prop = <1>;
	};
	node-c {
		prop = <3>;
	};
};
