/dts-v1/;

/ {

	base-node {

		sub-node {
			prop = <0x00>;
			phandle = <0x02>;
		};
	};

	somewhere {

		node-a1 {
			compatible = "abc,aaa";
			phandle = <0x01>;

			/export/ node_a: &{/somewhere/node-a1};
			/export/ other: &{/base-node/sub-node};
		};

		node-a2 {
			compatible = "abc,aaa";
			phandle = <0x03>;

			/export/ node_a: &{/somewhere/node-a2};
			/export/ other: &{/base-node/sub-node};

			addon-node {
				ref-other = <&{/base-node/sub-node} 0x0a>;
				prop = <0x00>;
			};
		};
	};
};
